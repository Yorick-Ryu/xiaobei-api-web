{
  "action": "set_cache_settings",
  "action_parameters": {
    "cache": true,
    "edge_ttl": { "mode": "bypass_by_default" },
    "browser_ttl": { "mode": "respect_origin" }
  },
  "description": "Cache BeiAPI plans HTML shell; API authentication stays dynamic",
  "enabled": true,
  "expression": "http.host eq \"www.beiapi.cn\" and http.request.uri.path eq \"/plans\""
}
